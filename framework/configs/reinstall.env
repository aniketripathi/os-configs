# reinstall.env — Framework Environment Variables
export OS_CONFIGS="/mnt/core/os-configs"
export FRAMEWORK="$OS_CONFIGS/framework"
export USER_CONFIGS="$OS_CONFIGS/user-configs"
export CUSTOM_CONFIGS="$USER_CONFIGS/custom"
export HOME_CONFIGS="$USER_CONFIGS/home"
export SYSTEM_CONFIGS="$USER_CONFIGS/system"
export SCRIPTS_DIR="$FRAMEWORK/scripts"
export CONFIGS_DIR="$FRAMEWORK/configs"
export AUTOMATION_DIR="$FRAMEWORK/automation"
export INIT_DIR="$OS_CONFIGS/init"

# Directories & Mount Points
export KEYS_DIR="$OS_CONFIGS/keys"
export CORE_MOUNT="/mnt/core"
export LIBRARY_MOUNT="/mnt/library"
export TEMP_MOUNT="/mnt/temp"
export GDRIVE_DIR="$CORE_MOUNT/gdrive"
export GDRIVE_BACKUP_DIR="$GDRIVE_DIR/backup"

# Archiving Details
export BACKUP_ARCHIVE="os-configs.7z"

# Identity Configuration — never hardcoded here.
# Real values live in keys/identity.env (gitignored, never pushed).
# Copy init/configs/identity.env.default -> keys/identity.env and fill it in,
# or run init/00-init-generate-defaults.sh --identity to generate it.
export IDENTITY_ENV="$KEYS_DIR/identity.env"
if [[ -f "$IDENTITY_ENV" ]]; then
    source "$IDENTITY_ENV"
else
    echo "[WARN] $IDENTITY_ENV not found — GIT_USER_EMAIL/GIT_USER_NAME/GITHUB_USERNAME unset."
fi
export RCLONE_REMOTE="gdrive"
