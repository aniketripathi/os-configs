# see `man dnf.conf` for options and defaults

[main]
# Select the fastest mirror from Fedora's mirrorlist
fastestmirror=True
# Allow up to 12 concurrent package downloads
max_parallel_downloads=12
# Default to Yes for all user prompts (useful for script execution)
defaultyes=True
# Cache downloaded RPMs locally rather than deleting after install
keepcache=True
# Number of download attempts before skipping package
retries=5
# Wait up to 30 seconds for unresponsive mirror links
timeout=30
# Automatically purge unused dependency packages during remove
clean_requirements_on_remove=True

# Exclude problematic packages (e.g. Cisco openh264 stubs)
exclude=openh264*
