# Git Global Configuration Template

[user]
	email = <email>
	name = <user-name>

[init]
	defaultBranch = main

[pull]
	rebase = true
	ff = only

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[color]
	ui = auto

[core]
	autocrlf = input
	editor = nano
	fsmonitor = false
	untrackedCache = true

[pack]
	threads = 0
