# gitconfig.default — Git Global Configuration Template

[user]
	# Git display credentials (populated dynamically from keys/identity.env)
	email = <email>
	name = <user-name>

[init]
	# Standardize main branch naming conventions
	defaultBranch = main

[pull]
	# Keep history clean by rebasing during updates
	rebase = true

[color]
	# Enable automatic terminal output color schemes
	ui = auto

[core]
	# Handle line endings properly on Linux systems
	autocrlf = input
	# Default terminal editor for writing commits
	editor = nano
