# identity.env.default — Local Environment User Identity Configuration
# INSTRUCTIONS: Copy this file to keys/identity.env and enter your personal details.
# keys/identity.env is gitignored and is never pushed to public repositories.

# Git configuration credentials
export GIT_USER_EMAIL="<email>"
export GIT_USER_NAME="<user-name>"

# GitHub user handle (used for authentication checks and repo cloning)
export GITHUB_USERNAME="<github-username>"
