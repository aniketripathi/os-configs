# Local Environment User Identity Configuration
# INSTRUCTIONS: Copy this file to the keys directory and enter your personal details.
# The keys directory is gitignored and is never pushed to public repositories.

# Git configuration credentials
export GIT_USER_EMAIL="<email>"
export GIT_USER_NAME="<user-name>"

# GitHub user handle (used for git remote repository paths setup)
export GITHUB_USERNAME="<github-username>"
