# Framework Directory Layout Configuration
# Defines mount points, repository directories, and key file paths.
# Enforce secure file creation permissions (directories: 750, files: 640)
umask 027

# --- Mount Points (Absolute Paths) ---
export CORE_MNT="/mnt/core"
export LIBRARY_MNT="/mnt/library"
export TEMP_MNT="/mnt/temp"

# --- Cloud Mounts ---
export GDRIVE_DIR="$CORE_MNT/gdrive"

# --- Core Directories ---
export OS_CONFIGS="${OS_CONFIGS:-$CORE_MNT/os-configs}"
export FRAMEWORK="$OS_CONFIGS/framework"
export INIT_DIR="$OS_CONFIGS/init"
export KEYS_DIR="$OS_CONFIGS/keys"

# --- User Configurations ---
export USER_CONFIGS="$OS_CONFIGS/user-configs"
export CUSTOM_CONFIGS="$USER_CONFIGS/custom"
export HOME_CONFIGS="$USER_CONFIGS/home"
export SYSTEM_CONFIGS="$USER_CONFIGS/system"

# --- Sub-directories ---
export SCRIPTS_DIR="$FRAMEWORK/scripts"
export CONFIGS_DIR="$FRAMEWORK/configs"
export LIB_DIR="$OS_CONFIGS/lib"

# --- Archiving Details ---
export RCLONE_REMOTE="gdrive"
export LOCAL_BACKUP_DIR="$OS_CONFIGS/backup"
export BACKUP_REPO_DIR="$LOCAL_BACKUP_DIR/repo"
export BACKUP_LIVE_DIR="$LOCAL_BACKUP_DIR/live"
export GDRIVE_BACKUP_DIR="$GDRIVE_DIR/backup"

# --- Load identity configuration if it exists ---
if [[ -f "$KEYS_DIR/identity.env" ]]; then
    source "$KEYS_DIR/identity.env"
fi
