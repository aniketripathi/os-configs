{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    {
      "type": "command",
      "key": "OS Age",
      "text": "echo $(( ($(date +%s) - $(stat -c %Y /var/log/anaconda/anaconda.log)) / 86400 )) days"
    },
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "break",
    {
      "type": "cpu",
      "temp": true
    },
    "cpuusage",
    {
      "type": "gpu",
      "temp": true,
      "driverSpecific": true,
      "format": "{name} ({driver}) | Temp: {temperature} | Usage: {core-usage-num} | VRAM: {dedicated-used} / {dedicated-total}"
    },
    "memory",
    "swap",
    "disk",
    {
      "type": "battery",
      "key": "Battery",
      "format": "{technology} | {capacity} ({status}) | Cycles: {cycle-count}"
    },
    "localip",
    "break",
    "theme",
    "terminal",
    "terminalfont",
    "vulkan",
    "opengl"
  ]
}
