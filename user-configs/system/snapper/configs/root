SUBVOLUME="/"
FSTYPE="btrfs"

# Use max 20% total size
SPACE_LIMIT=0.2
# Always keep 50% of total size free
FREE_LIMIT=0.5


# Snapshot config creation and deletion based on time
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
# Recent snapshots are more relevant and cheap, older are larger in disk
# Snapshots are taken every hour and maintained one (first) per unit time
# Keep snapshots for last x units
TIMELINE_LIMIT_HOURLY="24"
TIMELINE_LIMIT_DAILY="14"
TIMELINE_LIMIT_WEEKLY="4"
TIMELINE_LIMIT_MONTHLY="1"
TIMELINE_LIMIT_YEARLY="0"

# Disable pre-post and timeline cleanup
NUMBER_CLEANUP="no"
EMPTY_PRE_POST_CLEANUP="no"